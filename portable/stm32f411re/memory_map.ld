FLASH_BASE          = 0x08000000;
FLASH_SIZE          = 512K;
FLASH_KERNEL_SIZE   = 256K;
FLASH_USER_SIZE     = 256K;

SRAM_BASE           = 0x20000000;
SRAM_SIZE           = 128K;
SRAM_KERNEL_SIZE    = 64K;
SRAM_USER_SIZE      = 64K;

PERIPH_BASE         = 0x40000000;
PERIPH_SIZE         = 1M;

PRIV_PERIPH_BASE    = 0xE0000000;
PRIV_PERIPH_SIZE    = 1M;

KERNEL_STACK_SIZE   = 0x1000;
USER_STACK_DEFAULT  = 0x0800;
ISR_STACK_SIZE      = 0x0400;

FLASH_KERNEL_BASE   = FLASH_BASE;
FLASH_KERNEL_END    = FLASH_KERNEL_BASE + FLASH_KERNEL_SIZE;
FLASH_USER_BASE     = FLASH_KERNEL_END;
FLASH_USER_END      = FLASH_USER_BASE + FLASH_USER_SIZE;

SRAM_KERNEL_BASE    = SRAM_BASE;
SRAM_KERNEL_END     = SRAM_KERNEL_BASE + SRAM_KERNEL_SIZE;
SRAM_USER_BASE      = SRAM_KERNEL_END;
SRAM_USER_END       = SRAM_USER_BASE + SRAM_USER_SIZE;